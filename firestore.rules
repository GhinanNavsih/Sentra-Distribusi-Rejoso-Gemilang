rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthenticated() {
      return request.auth != null;
    }

    // The POS app at Canteen375 reads its delivery outbox with a dedicated
    // warehouse-375 account (bridge@warehouse375.com). That account also holds
    // users/{uid}.role == 'bridge', which is in no callable allow-list, so it
    // can read this one collection and nothing else.
    function isPosBridge() {
      return isAuthenticated() && request.auth.uid == '7H4EplY9JIedIdNXI1Of4Y8OmmA3';
    }

    function isReceiptMetadataUpdate() {
      return isAuthenticated()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'customer_name',
          'payment_method',
          'is_credit_sale'
        ]);
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if false;
    }

    match /products_test/{productId} {
      allow read: if true;
      allow create, update: if false;
      allow delete: if false;
    }

    match /inventory/{productId} {
      allow read: if true;
      allow write: if false;
    }

    match /inventory_test/{productId} {
      allow read: if true;
      allow write: if false;
    }

    match /customers/{customerId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /customers_test/{customerId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    // Product names for the link picker are read live from POS by a Cloud
    // Function using a service-account credential (see functions/index.js),
    // not mirrored into a collection here.
    match /pos_product_links/{productId} {
      allow read: if isAuthenticated() || isPosBridge();
      allow write: if false;
    }

    match /pos_product_links_test/{productId} {
      allow read: if isAuthenticated() || isPosBridge();
      allow write: if false;
    }

    match /deliveries_canteen375/{orderId} {
      allow read: if isPosBridge();
      allow write: if false;
    }

    match /deliveries_canteen375_test/{orderId} {
      allow read: if isPosBridge();
      allow write: if false;
    }

    match /orders/{orderId} {
      allow read: if isAuthenticated();
      allow create, delete: if false;
      allow update: if isReceiptMetadataUpdate();
    }

    match /orders_test/{orderId} {
      allow read: if isAuthenticated();
      allow create, delete: if false;
      allow update: if isReceiptMetadataUpdate();
    }

    match /purchases/{purchaseId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /purchases_test/{purchaseId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /stock_losses/{lossId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /stock_losses_test/{lossId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /stock_movements/{movementId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /stock_movements_test/{movementId} {
      allow read: if isAuthenticated();
      allow write: if false;
    }

    match /inventory_operations/{operationId} {
      allow read, write: if false;
    }

    match /inventory_operations_test/{operationId} {
      allow read, write: if false;
    }

    match /counters/{counterId} {
      allow read, write: if false;
    }

    match /counters_test/{counterId} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isAuthenticated() && request.auth.uid == userId;
      allow write: if false;
    }
  }
}
